# ===========================================
# EasyPanel Environment Variables
# ===========================================
# Copy this file and fill in your values
# These will be configured in EasyPanel UI

# ===========================================
# API SERVICE VARIABLES
# ===========================================

# Environment
ASPNETCORE_ENVIRONMENT=Production

# Database (EasyPanel will provide this automatically
# when you link the database to your app)
# Format: Host=host;Database=db;Username=user;Password=pass
DB_CONNECTION=

# JWT Secret - Generate with: openssl rand -base64 32
# Must be at least 32 characters
JWT_SECRET=your-secure-jwt-secret-min-32-chars-here

# JWT Settings
JWT_ISSUER=TimeTrack
JWT_AUDIENCE=TimeTrack.Api
JWT_ACCESS_TOKEN_EXPI_MINUTES=60
JWT_REFRESH_TOKEN_EXPI_DAYS=90

# Email (Resend)
RESEND_API_KEY=re_xxx_your_resend_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=TimeTrack

# Frontend URL (for CORS)
FRONTEND_URL=https://app.yourdomain.com

# Stripe (live mode keys from Stripe Dashboard)
# In .NET config, double-underscore maps to colon (Stripe:SecretKey)
Stripe__SecretKey=sk_live_xxx
Stripe__WebhookSecret=whsec_xxx

# Updates: Windows installer served via /api/v1/updates/download
# Provide the installer via a volume mount to `/app/updates/...` and set this path.
Updates__InstallerPath=/app/updates/Chronos-TimeTrack-Setup.exe

# ===========================================
# WEB (FRONTEND) SERVICE VARIABLES
# ===========================================

# API URL that the frontend will call
VITE_API_URL=https://api.yourdomain.com

# ===========================================
# EASYPANEL SPECIFIC
# ===========================================

# These are handled automatically by EasyPanel:
# - PORT (set to 8080 for API)
# - Database connection (when linked)
