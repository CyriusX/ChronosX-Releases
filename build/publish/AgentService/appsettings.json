{
  "Agent": {
    "PollingIntervalMs": 1000,
    "IdleThresholdSeconds": 300,
    "GracefulShutdownTimeoutSeconds": 10,
    "ProcessPriority": "BelowNormal",
    "DatabasePath": "timetrack.db",
    "EnableDiagnostics": false,
    "Sync": {
      "BackendUrl": "https://chronosx-timetrack-api.gpoda0.easypanel.host",
      "AuthToken": null,
      "SyncIntervalSeconds": 60,
      "MaxBatchSize": 100,
      "MaxBatchSizeBytes": 1048576,
      "HttpTimeoutSeconds": 30,
      "ConsecutiveFailuresAlertThreshold": 5
    }
  },
  "Update": {
    "Enabled": true,
    "Channel": "stable",
    "CheckIntervalMinutes": 240,
    "UpdateUrl": "https://chronosx-timetrack-api.gpoda0.easypanel.host/api/v1/updates",
    "DownloadTimeoutMinutes": 30,
    "VerifySignature": false,
    "BackupRetentionDays": 7,
    "CheckOnStartup": true,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "TimeTrack": "Debug"
    }
  }
}
