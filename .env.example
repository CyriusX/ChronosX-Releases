# Environment variables template
# Copy this to .env for local development or .env.production for production
# NEVER commit this file to git with real secrets!

# ===========================================
# REQUIRED - configure these before deployment
# ===========================================

ASPNETCORE_ENVIRONMENT=Production

# Database connection string
# Format: Host=<host>;Database=<database>;Username=<username>;Password=<password>;SSL Mode=Require
# Example: Host=localhost;Database=timetrack;Username=postgres;Password=secret;SSL Mode=Require
DB_CONNECTION=Host=localhost;Database=timetrack;Username=postgres;Password=changeme;SSL Mode=Require

# JWT Configuration
# Generate a secure secret (256+ bits / at least 32 characters)
# Run: openssl rand -base64 32  (on Linux/Mac) or use an online generator
JWT_SECRET=changeme-to-a-secure-32-character-secret-key

JWT_ISSUER=TimeTrack
JWT_AUDIENCE=TimeTrack.Api

# JWT token expiration
JWT_ACCESS_TOKEN_EXPI_MINUTES=60
JWT_REFRESH_TOKEN_EXPI_DAYS=90

# Email configuration (optional - configure if using email notifications)
# Sign up at https://resend.com to get your API key
RESEND_API_KEY=changeme-to-your-resend-api-key

# Email settings
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=TimeTrack

# Frontend URL for CORS
FRONTEND_URL=https://app.yourdomain.com

# Docker registry (optional - uncomment if using Docker Hub)
# docker_registry=your-registry/
