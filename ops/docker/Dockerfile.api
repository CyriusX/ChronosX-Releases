FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiar csprojs
COPY ["src/backend/TimeTrack.Api/TimeTrack.Api.csproj", "TimeTrack.Api/"]
COPY ["src/backend/TimeTrack.Backend.Application/TimeTrack.Backend.Application.csproj", "TimeTrack.Backend.Application/"]
COPY ["src/backend/TimeTrack.Backend.Domain/TimeTrack.Backend.Domain.csproj", "TimeTrack.Backend.Domain/"]
COPY ["src/backend/TimeTrack.Backend.Infrastructure/TimeTrack.Backend.Infrastructure.csproj", "TimeTrack.Backend.Infrastructure/"]

# Restore
RUN dotnet restore "TimeTrack.Api/TimeTrack.Api.csproj"

# Copiar código fonte
COPY src/backend/. .

# Build
WORKDIR "/src/TimeTrack.Api"
RUN dotnet build "TimeTrack.Api.csproj" -c Release -o /app/build

# Publish
FROM build AS publish
RUN dotnet publish "TimeTrack.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Final stage - production ready
FROM base AS final
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app

# Copy published application
COPY --from=publish --chown=appuser:appuser /app/publish .

# Create updates directory (installer is provided at runtime via volume mount)
RUN mkdir -p /app/updates && chown -R appuser:appuser /app/updates

# Switch to non-root user
USER appuser

# Health check with adjusted timing for containerized environments
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose port
EXPOSE 8080

# Entry point
ENTRYPOINT ["dotnet", "TimeTrack.Api.dll"]
