# Stage 1: Build the React application
FROM node:20-alpine AS builder

WORKDIR /app

# EasyPanel/CI environments sometimes disable optional deps globally; Tailwind v4
# (via lightningcss) relies on optional native binaries. Force them on.
ENV npm_config_optional=true

# Copy package files for both projects
COPY src/ui/timetrack-ui/package*.json ./src/ui/timetrack-ui/
COPY src/ui/timetrack-web/package*.json ./src/ui/timetrack-web/

# Install dependencies for timetrack-ui first (shared components)
WORKDIR /app/src/ui/timetrack-ui
RUN npm ci --include=optional

# Install dependencies for web
WORKDIR /app/src/ui/timetrack-web
RUN npm ci --include=optional

# Go back to root for consistency
WORKDIR /app

# Copy source code
COPY src/ui/timetrack-ui/ ./src/ui/timetrack-ui/
COPY src/ui/timetrack-web/ ./src/ui/timetrack-web/

# Build argument for API URL
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build the application from the web directory
WORKDIR /app/src/ui/timetrack-web
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Install curl for health check
RUN apk add --no-cache curl

# Re-declare ARG so it's available in this stage for the ENV below
ARG VITE_API_URL=https://chronosx-dev-timetrack-api.gpoda0.easypanel.host/api/v1
ENV VITE_API_URL=$VITE_API_URL

# Copy custom nginx config
COPY ops/nginx/ui-nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy runtime config generator script
COPY ops/docker/config-loader.js /docker-entrypoint.d/40-config-generator.sh
RUN chmod +x /docker-entrypoint.d/40-config-generator.sh

# Expose port 80
EXPOSE 80

# Health check using curl
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

# Start nginx (docker-entrypoint.d scripts run automatically)
CMD ["nginx", "-g", "daemon off;"]
