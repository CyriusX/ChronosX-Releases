{
  "Agent": {
    "PollingIntervalMs": 2000,
    "IdleThresholdSeconds": 300,
    "GracefulShutdownTimeoutSeconds": 10,
    "DatabasePath": "timetrack.db",
    "EnableDiagnostics": true,
    "SocketPath": "/var/tmp/TimeTrack.Agent.IPC",
    "Sync": {
      "BackendUrl": "https://localhost:5001",
      "AuthToken": null,
      "SyncIntervalSeconds": 30,
      "MaxBatchSize": 100,
      "MaxBatchSizeBytes": 1048576,
      "HttpTimeoutSeconds": 30,
      "ConsecutiveFailuresAlertThreshold": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "TimeTrack": "Debug"
    }
  }
}
