{
  "Agent": {
    "PollingIntervalMs": 500,
    "IdleThresholdSeconds": 30,
    "EnableDiagnostics": true,
    "Sync": {
      "BackendUrl": "http://127.0.0.1:5000"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "TimeTrack": "Debug"
    }
  }
}
