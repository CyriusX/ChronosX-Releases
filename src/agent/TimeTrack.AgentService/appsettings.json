{
  "Agent": {
    "PollingIntervalMs": 1000,
    "IdleThresholdSeconds": 60,
    "GracefulShutdownTimeoutSeconds": 10,
    "ProcessPriority": "BelowNormal",
    "DatabasePath": "timetrack.db",
    "EnableDiagnostics": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "TimeTrack": "Debug"
    }
  }
}
