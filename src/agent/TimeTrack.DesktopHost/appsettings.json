{
  "DesktopHost": {
    "UiBundlePath": "ui",
    "PipeName": "TimeTrack.Agent.IPC",
    "ConnectionTimeoutMs": 5000,
    "ReconnectionDelayMs": 1000,
    "MaxReconnectionAttempts": 10,
    "WindowWidth": 1280,
    "WindowHeight": 800,
    "AppTitle": "ChronosX",
    "StartMinimized": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "Sync": {
      "BackendUrl": "https://chronosx-timetrack-api.gpoda0.easypanel.host",
      "AuthToken": null,
      "SyncIntervalSeconds": 60,
      "MaxBatchSize": 100,
      "MaxBatchSizeBytes": 1048576,
      "HttpTimeoutSeconds": 30,
      "ConsecutiveFailuresAlertThreshold": 5
    }
  }
}
