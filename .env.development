# Development environment variables template
# Copy this to .env and rename to .env.development

# Never commit this files to git!

# Database connection string
# Use postgres container from docker-compose for local development
DB_CONNECTION=Host=postgres;Database=timetrack;Username=postgres;Password=postgres

# JWT Configuration (use a secure 32+ character secret for production)
JWT_SECRET=dev-secret-min-32-characters-long-for-development

# Email API key (Resend) - optional for development
RESEND_API_KEY=
